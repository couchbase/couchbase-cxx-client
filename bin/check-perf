      h3 { font: 600 13px ui-monospace, monospace; margin: 1.25rem 0 .5rem; }
      .family { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: .75rem; }
      .chart { border: 1px solid var(--grid); border-radius: 6px; padding: .5rem; min-width: 0; }
      h4 { font: 12px ui-monospace, monospace; margin: 0; word-break: break-all; }
      .latest { display: flex; flex-wrap: wrap; column-gap: .75em; font-size: 12px; font-variant-numeric: tabular-nums; }
      .latest span { white-space: nowrap; }
      .delta { color: var(--muted); }
      .better { color: var(--c); }
      .plot { display: grid; grid-template-columns: auto 1fr; gap: .375rem; margin-top: .25rem; }
      .axis { display: flex; flex-direction: column; justify-content: space-between; color: var(--muted); font: 10px/1 system-ui, sans-serif; text-align: right; font-variant-numeric: tabular-nums; }
      .axis.flat { justify-content: center; }
      svg { width: 100%; height: 5rem; display: block; }
      .grid { stroke: var(--grid); }
      .series { fill: none; stroke: var(--c); stroke-width: 1.5; }
      .pt { fill: var(--c); }
      .pt.ring { fill: var(--bg); stroke: var(--c); stroke-width: 1.5; }
      .muted { color: var(--muted); }
    </style></head>
    <body>
    <h1>Performance history</h1>
    <p class="muted">Each chart plots one benchmark key at each commit of main, oldest to newest. Each point links to its commit. A hollow ring marks a point that ran on a different CPU model than the point before it in the same chart.</p>
    <nav id="jump" aria-label="Measures"></nav>
    <p id="status" class="muted">Loading.</p>
    <main id="charts"></main>
    <script>
    "use strict";
    const REPO_URL = "@REPO_URL@";
    const NS = "http://www.w3.org/2000/svg";
    const get = (url) => fetch(url).then((r) => { if (!r.ok) throw new Error(url + ": " + r.status); return r.json(); });
    const el = (name, attrs, parent) => {
      const e = document.createElementNS(NS, name);
      for (const k in attrs) e.setAttribute(k, attrs[k]);
      if (parent) parent.appendChild(e);
      return e;
    };
    const h = (name, attrs = {}, text) => {
      const e = document.createElement(name);
      for (const k in attrs) e.setAttribute(k, attrs[k]);
      if (text !== undefined) e.textContent = text;
      return e;
    };
    const duration = (ns) => ns >= 1_000_000_000 ? (ns / 1_000_000_000).toPrecision(3) + " s" : ns >= 1_000_000 ? (ns / 1_000_000).toPrecision(3) + " ms"
      : ns >= 1_000 ? (ns / 1_000).toPrecision(3) + " µs" : ns.toPrecision(3) + " ns";

    const bytes = (b) => b >= 1_073_741_824 ? (b / 1_073_741_824).toPrecision(3) + " GiB" : b >= 1_048_576 ? (b / 1_048_576).toPrecision(3) + " MiB"
      : b >= 1_024 ? (b / 1_024).toPrecision(3) + " KiB" : b + " B";

    const rate = (v) => (v >= 1_000_000 ? (v / 1_000_000).toPrecision(3) + "M" : v >= 1_000 ? (v / 1_000).toPrecision(3) + "k"
      : v.toPrecision(3)) + " ops/s";

    // One section per measure, in this order. colour names a custom property of the stylesheet;
    // better is "lower" or "higher".
    const MEASURES = [
      {id: "latency", title: "Latency", colour: "--latency", fmt: duration, better: "lower", value: (row) => row.median,
       about: "Median time per operation of each key, per iteration for batched keys."},
      {id: "throughput", title: "Throughput", colour: "--throughput", fmt: rate, better: "higher", value: (row) => row.ops_per_second,
       about: "Operations per second across all threads of the key, for per-operation keys."},
      {id: "cpu", title: "CPU time per operation", colour: "--cpu", fmt: duration, better: "lower", value: (row) => row.cpu_ns_per_op,
       about: "CPU time of the whole benchmark process per operation, per iteration for batched keys. Every thread counts."},
      {id: "rss", title: "Peak RSS", colour: "--rss", fmt: bytes, better: "lower", value: (row) => row.max_rss_bytes,
       about: "Peak resident set size of the process when the key finished. It is a high-water mark, so it covers every key the binary measured before."},
    ];

    function chart(m, key, name, points) {
      const box = h("div", {class: "chart", title: key});
      const last = points[points.length - 1].v, prev = points.length > 1 ? points[points.length - 2].v : 0;
      const latest = h("div", {class: "latest"});
      latest.append(h("span", {}, m.fmt(last)));
      if (prev) {
        const pct = (last - prev) / prev * 100;
        latest.append(h("span", {class: "delta"}, (pct < 0 ? "−" : "+") + Math.abs(pct).toFixed(1) + "% vs previous"));
      }
      latest.append(h("span", {class: "better"}, m.better === "higher" ? "▲ higher is better" : "▼ lower is better"));
      const vs = points.map((p) => p.v);
      const lo = Math.min(...vs), hi = Math.max(...vs);
      // The plot is scaled to its own range, so the axis prints that range.
      const plot = h("div", {class: "plot"});
      const axis = h("div", {class: hi === lo ? "axis flat" : "axis", "aria-hidden": "true"});
      axis.append(...(hi === lo ? [h("span", {}, m.fmt(hi))] : [h("span", {}, m.fmt(hi)), h("span", {}, m.fmt(lo))]));
      plot.append(axis);
      box.append(h("h4", {}, name), latest, plot);
      const W = 320, H = 80, P = 6;
      const svg = el("svg", {viewBox: "0 0 " + W + " " + H, preserveAspectRatio: "none"}, plot);
      const x = (i) => points.length === 1 ? W / 2 : P + i * (W - 2 * P) / (points.length - 1);
      // A series without spread is drawn at mid-height, apart from the baseline.
      const y = (v) => hi === lo ? H / 2 : H - P - (v - lo) * (H - 2 * P) / (hi - lo);
      el("line", {class: "grid", x1: 0, x2: W, y1: H - 1, y2: H - 1}, svg);
      el("polyline", {class: "series", "vector-effect": "non-scaling-stroke",
                      points: points.map((p, i) => x(i) + "," + y(p.v)).join(" ")}, svg);
      points.forEach((p, i) => {
        const a = el("a", {href: REPO_URL + "/commit/" + p.sha}, svg);
        const c = el("circle", {class: p.cpuChanged ? "pt ring" : "pt", cx: x(i), cy: y(p.v), r: p.cpuChanged ? 4.5 : 3,
                                "vector-effect": "non-scaling-stroke"}, a);
        el("title", {}, c).textContent = p.sha.slice(0, 12) + "  " + m.fmt(p.v) + "  " + p.date +
          (p.cpuChanged ? "\nCPU: " + p.cpu + " (changed)" : "");
      });
      return box;
    }

    async function main() {
      // Only entries with a commit id are fetched and linked: the id becomes part of a path and a URL.
      const index = (await get("data/index.json")).reverse()
        .filter((e) => e && typeof e.sha === "string" && /^[0-9a-f]{7,40}$/.test(e.sha));
      const docs = await Promise.all(index.map((e) => get("data/" + e.sha + ".json").catch(() => null)));
      const series = new Map(MEASURES.map((m) => [m.id, new Map()]));
      docs.forEach((d, i) => {
        if (!d || typeof d !== "object") return;
        for (const key in d.rows) {
          const row = d.rows[key];
          if (!row || typeof row !== "object") continue;
          const cpu = row.cpu_model || "unknown";
          for (const m of MEASURES) {
            const v = m.value(row);
            if (typeof v !== "number" || !Number.isFinite(v)) continue;
            const charts = series.get(m.id);
            if (!charts.has(key)) charts.set(key, []);
            const points = charts.get(key);
            const cpuChanged = points.length > 0 && cpu !== points[points.length - 1].cpu;
            points.push({sha: index[i].sha, date: index[i].date, v, cpu, cpuChanged});
          }
        }
      });
      const nav = document.getElementById("jump"), root = document.getElementById("charts");
      for (const m of MEASURES) {
        const charts = series.get(m.id);
        if (!charts.size) continue;
        const colour = "--c: var(" + m.colour + ")";
        const section = h("section", {id: m.id, style: colour});
        const heading = h("h2");
        heading.append(h("span", {class: "swatch"}), m.title);
        section.append(heading, h("p", {class: "muted"}, m.about));
        // A key's family is its first "/" segment; the chart is titled with the rest.
        const families = new Map();
        for (const key of charts.keys()) {
          const cut = key.indexOf("/");
          const family = cut < 0 ? key : key.slice(0, cut);
          if (!families.has(family)) families.set(family, []);
          families.get(family).push({key, name: cut < 0 ? key : key.slice(cut + 1)});
        }
        for (const family of [...families.keys()].sort()) {
          const grid = h("div", {class: "family"});
          for (const {key, name} of families.get(family).sort((a, b) => a.name < b.name ? -1 : 1)) {
            grid.append(chart(m, key, name, charts.get(key)));
          }
          section.append(h("h3", {}, family), grid);
        }
        root.append(section);
        const link = h("a", {href: "#" + m.id, style: colour});
        link.append(h("span", {class: "swatch"}), m.title);
        nav.append(link);
      }
      document.getElementById("status").textContent = nav.childElementCount ? "" : "No results recorded yet.";
    }
    main().catch((e) => { document.getElementById("status").textContent = "Could not load the results: " + e.message; });
    </script>
    </body></html>
  HTML

  def self.repository = ENV.fetch("GITHUB_REPOSITORY", "couchbase/couchbase-cxx-client")

  def self.perf_page = PAGE.sub("@REPO_URL@", "https://github.com/#{repository}")

  # abi_page(file, reports_dir) writes abi/index.html; by default bin/check-abi report renders it
  # from the deployments API and the reports in reports_dir.
  ABI_PAGE = lambda do |file, reports_dir|
    run(File.join(__dir__, "check-abi"), "report", file, reports_dir)
  end

  # Builds the site to deploy in to from the data of from, a checkout of PagesSite::REF, with the
  # pages of this checkout. Only perf/data/*.json and abi/reports/COMMIT/report-*.txt, COMMIT 40
  # lowercase hex digits, are taken from from, so no page pushed to the ref is deployed. A symbolic
  # link on either path is an error: publishing never writes one, and following it would deploy a
  # file of the runner.
  def self.render_site(from, to, abi_page: ABI_PAGE)
    FileUtils.rm_rf(to)
    FileUtils.mkdir_p(to)
    no_link = ->(path) { raise Error, "#{path} is a symbolic link" if File.symlink?(path) }
    data_dir = File.join(from, "perf", "data")
    [File.join(from, "perf"), data_dir].each(&no_link)
    data = Dir.glob(File.join(data_dir, "*.json")).each(&no_link).select { |f| File.file?(f) }
    unless data.empty?
      FileUtils.mkdir_p(File.join(to, "perf", "data"))
      FileUtils.cp(data, File.join(to, "perf", "data"))
      File.write(File.join(to, "perf", "index.html"), perf_page)
    end
    reports_dir = File.join(from, "abi", "reports")
    [File.join(from, "abi"), reports_dir].each(&no_link)
    commits = File.directory?(reports_dir) ? Dir.children(reports_dir).grep(/\A[0-9a-f]{40}\z/) : []
    commits.each do |commit|
      dir = File.join(reports_dir, commit)
      no_link.call(dir)
      next unless File.directory?(dir)

      reports = Dir.children(dir).grep(/\Areport-[\w.-]+\.txt\z/).map { |f| File.join(dir, f) }.each(&no_link).select { |f| File.file?(f) }
      next if reports.empty?

      FileUtils.mkdir_p(File.join(to, "abi", "reports", commit))
      FileUtils.cp(reports, File.join(to, "abi", "reports", commit))
    end
    FileUtils.mkdir_p(File.join(to, "abi"))
    abi_page.call(File.join(to, "abi", "index.html"), File.join(to, "abi", "reports"))
    File.write(File.join(to, "index.html"), PagesSite.render_index(to))
  end

  # The data of one push. Each measured row of the result.json of each dir gives its head median and
  # the CPU model of the dir. The head's CI bounds, CPU time per operation, peak RSS and throughput
  # are added where the row has them. A result of another commit, and a row that failed at head, are
  # left out.
  def self.push_data(commit, date, dirs)
    rows = {}
    first = nil
    dirs.each do |dir|
      path = artifact_file(dir, "result.json") or next
      result = JSON.parse(File.read(path))
      raise Error, "#{path} is not a result written by bin/check-perf" unless result.is_a?(Hash) && result["rows"].is_a?(Array) &&
                                                                              result["head"].is_a?(Hash)
      if result.dig("head", "sha") != commit
        puts "Skipped #{path}: it is the result of #{result.dig('head', 'sha').to_s[0, 12]}, not #{commit[0, 12]}"
        next
      end
      cpu = result.dig("metadata", "cpu", "model")
      first ||= cpu
      result["rows"].each do |row|
        raise Error, "#{path} has a row without a key" unless row.is_a?(Hash) && row["key"].is_a?(String)

        head = row["head"]
        next if head.nil? || row["verdict"] == "failed"
        unless head.is_a?(Hash) && number?(head["median"])
          raise Error, "#{path}: the head of #{row['key']} has no numeric median"
        end

        at = ->(*path) { path.reduce(row) { |v, k| v.is_a?(Hash) ? v[k] : nil } }
        usage = {"cpu_ns_per_op" => at.call("cpu", "head", "median"), "max_rss_bytes" => at.call("max_rss_bytes", "head"),
                 "ops_per_second" => at.call("throughput", "head", "median")}
        rows[row["key"]] = head.slice("median", "lower", "upper").select { |_, v| number?(v) }.merge("cpu_model" => cpu)
                               .merge(usage.select { |_, v| number?(v) })
      end
    rescue JSON::ParserError => e
      raise Error, "#{path} is not JSON: #{e.message}"
    end
    {"sha" => commit, "date" => date, "cpu_model" => first, "rows" => rows.sort.to_h}
  end

  # Adds the head rows of commit to perf/data/ in the site and renders perf/index.html. index.json
  # lists the commits newest first by commit date.
  def self.publish(commit, dirs, url: "https://github.com/#{repository}.git", token: ENV["GH_TOKEN"] || ENV.fetch("GITHUB_TOKEN", nil),
                   site: nil, attempts: 5)
    commit = run("git", "rev-parse", "--verify", "#{commit}^{commit}", quiet: true).strip
    date = run("git", "show", "-s", "--format=%cI", commit, quiet: true).strip
    data = push_data(commit, date, dirs)
    if data["rows"].empty?
      puts "No rows to publish for #{commit[0, 12]}"
      return 0
    end

    Dir.mktmpdir do |tmp|
      pushed = PagesSite.publish(url: url, token: token, site: site || File.join(tmp, "site"), attempts: attempts,
                                 message: "Performance history at #{commit[0, 12]}") do |root|
        dir = File.join(root, "perf", "data")
        FileUtils.mkdir_p(dir)
        File.write(File.join(dir, "#{commit}.json"), "#{JSON.pretty_generate(data)}\n")
        index_file = File.join(dir, "index.json")
        index = File.file?(index_file) ? JSON.parse(File.read(index_file)) : []
        index = index.reject { |e| e["sha"] == commit }
                     .push({"sha" => commit, "date" => date, "cpu_model" => data["cpu_model"]})
                     .sort_by { |e| [Time.iso8601(e["date"]), e["sha"]] }.reverse
        File.write(index_file, "#{JSON.pretty_generate(index)}\n")
        File.write(File.join(root, "perf", "index.html"), perf_page)
      end
      puts pushed ? "Published #{data['rows'].size} rows of #{commit[0, 12]} to #{PagesSite::REF}" : "#{PagesSite::REF} is up to date"
    end
    0
  rescue PagesSite::Error => e
    raise Error, e.message
  end

  def self.self_test
    check = ->(name, actual, expected) { raise "#{name}: expected #{expected.inspect}, got #{actual.inspect}" unless actual == expected }
    flat = [100.0] * 7
    faster = [0.80, 0.82, 0.81, 0.83, 0.79, 0.81, 0.80]
    ci = median_ci(faster)
    check.call("median_ci median", ci[:median], 0.81)
    check.call("median_ci excludes 1.0", ci[:upper] < 1, true)
    check.call("median_ci too few", median_ci(faster[0, 5]).values_at(:median, :lower, :upper), [0.81, nil, nil])
    check.call("ci_ranks n=5", ci_ranks(5), nil)
    check.call("ci_ranks n=6", ci_ranks(6), [0, 5])
    check.call("ci_ranks n=7", ci_ranks(7), [0, 6])
    check.call("ci_ranks n=8", ci_ranks(8), [0, 7])
    # 2 * P(Bin(100, 1/2) <= 39) is 0.035, and <= 40 is 0.057.
    check.call("ci_ranks n=100", ci_ranks(100), [39, 60])
    check.call("verdict faster", verdict(faster, flat), "faster")
    check.call("verdict too few ratios", verdict(faster[0, 5], flat[0, 5]), "noisy")
    check.call("verdict slower", verdict([1.20, 1.18, 1.22, 1.19, 1.21, 1.20, 1.19], flat), "slower")
    check.call("verdict small change", verdict([0.985, 0.99, 0.995, 0.987, 0.992, 0.99, 0.988], flat), "likely faster")
    check.call("verdict straddles one", verdict([0.9, 1.1, 0.95, 1.05, 1.0, 1.0, 0.98], flat), "no change")
    # The median moves by 3%, but the CI bound nearest 1.0 only by 1%.
    check.call("verdict bound under effect", verdict([0.96, 0.97, 0.97, 0.97, 0.99, 0.97, 0.96], flat), "likely faster")
    check.call("verdict likely slower", verdict([1.01, 1.015, 1.005, 1.01, 1.03, 1.01, 1.02], flat), "likely slower")
    check.call("verdict bound touches one", verdict([0.97, 0.98, 0.99, 0.98, 1.0, 0.98, 0.97], flat), "no change")
    check.call("verdict bound at effect", verdict([0.96, 0.97, 0.97, 0.97, 0.98, 0.97, 0.96], flat), "faster")
    sha = "a" * 40
    check.call("ci pull_request", ci_plan("pull_request", {"pull_request" => {"number" => 42}}, nil), ["HEAD^1", "HEAD", 42])
    check.call("ci push", ci_plan("push", {}, sha), [sha, "HEAD", nil])
    check.call("ci new branch", ci_plan("push", {}, NULL_SHA), [NULL_SHA, "HEAD", nil])
    check.call("ci dispatch", ci_plan("workflow_dispatch", {}, ""), ["HEAD^1", "HEAD", nil])
    status = ->(&block) { block.call rescue $ERROR_INFO.status }
    check.call("ci unknown event", status.call { ci_plan("schedule", {}, nil) }, 3)
    check.call("ci payload without number", status.call { ci_plan("pull_request", {}, nil) }, 3)
    check.call("ci payload not an object", status.call { ci_plan("pull_request", [], nil) }, 3)
    check.call("ci no event env", status.call { ci_event({}) }, 3)
    check.call("ci missing payload file", status.call { ci_event("GITHUB_EVENT_NAME" => "push", "GITHUB_EVENT_PATH" => "/nonexistent/event.json") }, 3)
    Dir.mktmpdir("check-perf-event") do |dir|
      bad = File.join(dir, "event.json")
      File.write(bad, "{")
      check.call("ci malformed payload", status.call { ci_event("GITHUB_EVENT_NAME" => "push", "GITHUB_EVENT_PATH" => bad) }, 3)
    end
    check.call("order", (0..3).map { |r| order(r) }, [%i[base head], %i[head base], %i[base head], %i[head base]])
    check.call("verdict noisy", verdict(faster, [100.0, 111.0, 101.0, 99.0, 100.0, 100.0, 100.0]), "noisy")
    check.call("verdict noisy boundary", verdict(faster, [100.0, 109.0, 101.0, 99.0, 100.0, 100.0, 100.0]), "faster")

    kase = ->(key, median, status = "measured") { {"key" => key, "status" => status, "latency_ns" => {"median" => median}, "errors" => 0} }
    rounds = ->(key, median) { Array.new(7) { kase.call(key, median) } }
    none = Array.new(7)
    check.call("new", row("a", none, rounds.call("a", 10.0))[:verdict], "new")
    check.call("removed", row("a", rounds.call("a", 10.0), none)[:verdict], "removed")
    check.call("unchanged row", row("a", rounds.call("a", 10.0), rounds.call("a", 10.0))[:verdict], "no change")
    # Per-operation cases write integer medians, which must not divide as integers.
    integer_row = row("a", rounds.call("a", 29_950), rounds.call("a", 29_900))
    check.call("integer medians", [integer_row[:verdict], integer_row[:ratio][:median].round(4)], ["likely faster", 0.9983])
    check.call("skipped on both", row("a", Array.new(7) { kase.call("a", 0, "skipped") },
                                      Array.new(7) { kase.call("a", 0, "skipped") }), nil)
    check.call("failed at head", row("a", rounds.call("a", 10.0),
                                     [*rounds.call("a", 9.0)[0, 6], kase.call("a", 0, "failed")])[:verdict], "failed")
    unpaired = row("a", [*rounds.call("a", 10.0)[0, 3], nil, nil, nil, nil], [nil, nil, nil, *rounds.call("a", 10.0)[0, 4]])
    check.call("no paired round", [verdict_text(unpaired), unpaired[:ratio]],
               ["noisy (no round measured it at both base and head)", nil])
    few = row("a", rounds.call("a", 10.0), [nil, nil, *rounds.call("a", 8.0)[0, 5]])
    check.call("fewer paired rounds than a CI needs", [verdict_text(few), few[:ratio][:lower], change(few[:ratio])],
               ["noisy (fewer than 6 paired rounds)", nil, "-20.0%"])
    check.call("schema keeps null sides", row("a", none, rounds.call("a", 10.0)).key?(:base), true)
    base_failed = row("a", Array.new(7) { kase.call("a", 0, "failed") }, rounds.call("a", 10.0))
    check.call("base failed", verdict_text(base_failed), "new (base failed)")
    check.call("new is not base failed", verdict_text(row("a", none, rounds.call("a", 10.0))), "new")
    suspect = row("a", Array.new(7) { kase.call("a", 0.2, "suspect") }, Array.new(7) { kase.call("a", 0.2, "suspect") })
    check.call("suspect noted", verdict_text(suspect), "no change (suspect)")
    check.call("measured is not suspect", verdict_text(row("a", rounds.call("a", 10.0), rounds.call("a", 10.0))), "no change")
    check.call("harness changed", verdict_text(row("a", rounds.call("a", 10.0), rounds.call("a", 10.0), harness_changed: true)),
               "no change (harness changed)")
    with_cpu = ->(key, median, cpu) { Array.new(7) { kase.call(key, median).merge("cpu_ns_per_op" => cpu, "max_rss_bytes" => 1 << 20) } }
    cpu_row = row("a", with_cpu.call("a", 10.0, 200.0), with_cpu.call("a", 10.0, 150.0))
    check.call("cpu verdict", [cpu_row[:verdict], cpu_row[:cpu][:verdict], cpu_row[:cpu][:ratio][:median]], ["no change", "faster", 0.75])
    check.call("cpu peak rss", cpu_row[:max_rss_bytes], {base: 1 << 20, head: 1 << 20})
    no_cpu = row("a", rounds.call("a", 10.0), with_cpu.call("a", 10.0, 150.0))
    check.call("cpu absent at base", [no_cpu[:cpu][:verdict], no_cpu[:cpu][:base], cpu_columns(no_cpu)], [nil, nil, ["-", "150 ns", "-", "-"]])
    check.call("cpu null", row("a", with_cpu.call("a", 10.0, nil), with_cpu.call("a", 10.0, nil))[:cpu][:verdict], nil)
    with_ops = ->(median, ops) { Array.new(7) { kase.call("a", median).merge("ops_per_second" => ops) } }
    # Slower per operation, yet more operations per second in all.
    more = row("a", with_ops.call(10.0, 100_000.0), with_ops.call(12.0, 125_000.0))
    check.call("throughput higher is faster", [more[:verdict], more[:throughput][:verdict], throughput_columns(more)],
               ["slower", "faster", ["100k", "125k", "+25.0% [+25.0%, +25.0%]", "faster"]])
    less = row("a", with_ops.call(10.0, 1_250_000.0), with_ops.call(10.0, 1_000_000.0))
    check.call("throughput lower is slower", throughput_columns(less), ["1.25M", "1.00M", "-20.0% [-20.0%, -20.0%]", "slower"])
    spread = Array.new(7) { |i| kase.call("a", 10.0).merge("ops_per_second" => i.zero? ? 120_000.0 : 100_000.0) }
    check.call("throughput noisy on base spread", row("a", spread, with_ops.call(10.0, 150_000.0))[:throughput][:verdict], "noisy")
    no_ops = row("a", rounds.call("a", 10.0), with_ops.call(10.0, 1_000.0))
    check.call("throughput absent at base", [no_ops[:throughput][:verdict], throughput_columns(no_ops)], [nil, ["-", "1.00k", "-", "-"]])
    batched = row("a", rounds.call("a", 10.0), rounds.call("a", 10.0))
    check.call("throughput absent on both", [batched.key?(:throughput), throughput_columns(batched)], [false, ["-"] * 4])
    failed_ops = row("a", with_ops.call(10.0, 1_000.0), [*with_ops.call(10.0, 2_000.0)[0, 6], kase.call("a", 0, "failed")])
    check.call("throughput failed at head", failed_ops[:throughput][:verdict], nil)

    begin
      check_unique("build/test/benchmark_kv_fake" => %w[kv_get/fake/t1 kv_get/fake/t8],
                   "build/test/benchmark_kv_cluster" => %w[kv_get/cluster/t1 kv_get/fake/t8])
      raise "duplicate_key_across_binaries: no error raised"
    rescue Error => e
      check.call("duplicate_key_across_binaries status", e.status, 3)
      check.call("duplicate_key_across_binaries names",
                 e.message.include?("benchmark_kv_fake") && e.message.include?("benchmark_kv_cluster"), true)
    end
    check_unique("build/test/benchmark_kv_fake" => %w[kv_get/fake/t1], "build/test/benchmark_kv_cluster" => %w[kv_get/cluster/t1])
    begin
      check_unique("build/test/benchmark_kv_fake" => %w[kv_fake/kv_get kv_fake/kv_get])
      raise "duplicate_key_in_one_binary: no error raised"
    rescue Error => e
      check.call("duplicate_key_in_one_binary", e.message, "kv_fake/kv_get is reported twice by build/test/benchmark_kv_fake")
    end

    Dir.mktmpdir("check-perf-case-level") do |tmp|
      # kv_fake and kv_cluster both register kv_get; a failure before either reached a key must not collide.
      fake = lambda do |suite, key|
        File.join(tmp, "benchmark_#{suite}").tap do |path|
          json = JSON.generate("schema" => 1, "cases" => [{"key" => key, "status" => "failed", "detail" => "setup"}])
          File.write(path, "#!/bin/sh\nprintf '%s' '#{json}' > \"$2\"\n[ \"$3\" = --bmf ] && printf '{}' > \"$4\"\nexit 1\n")
          File.chmod(0o755, path)
        end
      end
      run_compare = lambda do |dir, *binaries|
        FileUtils.mkdir_p(dir)
        File.write(File.join(dir, "benchmarks.txt"), binaries.join("\n"))
        out, err = $stdout, $stderr
        $stdout = $stderr = null = File.open(File::NULL, "w")
        code = compare(dir, dir, rounds: 1, suites: [], out: File.join(dir, "out"), work: File.join(tmp, "work"))
        [code, JSON.parse(File.read(File.join(dir, "out", "result.json")))["rows"].map { |r| [r["key"], r["verdict"]] }]
      ensure
        $stdout, $stderr = out, err if out
        null&.close
      end
      check.call("case_level_results_qualified",
                 run_compare.call(File.join(tmp, "a"), fake.call("kv_fake", "kv_get"), fake.call("kv_cluster", "kv_get")),
                 [1, [%w[kv_cluster/kv_get failed], %w[kv_fake/kv_get failed]]])
      begin
        run_compare.call(File.join(tmp, "b"), fake.call("x", "kv_get/fake/t1"), fake.call("y", "kv_get/fake/t1"))
        raise "duplicate_measured_key_across_binaries: no error raised"
      rescue Error => e
        check.call("duplicate_measured_key_across_binaries", e.message.start_with?("kv_get/fake/t1 is registered by both"), true)
      end
    end

    Dir.mktmpdir("check-perf-self-test") do |tmp|
      # A binary that exits 1 before writing --json must not be read as the previous run's results.
      binary = File.join(tmp, "benchmark_throws")
      File.write(binary, "#!/bin/sh\nexit 1\n")
      File.chmod(0o755, binary)
      json = File.join(tmp, "out.json")
      File.write(json, JSON.generate("schema" => 1, "cases" => []))
      begin
        measure(binary, json)
        raise "stale_result: no error raised"
      rescue Error => e
        check.call("stale_result", [e.status, e.message.include?("wrote no results"), File.exist?(json)], [3, true, false])
      end

      missing = side("check-perf-no-such-revision", File.join(tmp, "work"), [], required: false)
      check.call("unresolvable base", [missing.status, missing.binaries, missing.reason.include?("cannot be resolved")],
                 ["missing", {}, true])
      rendered = {base: {sha: missing.label, status: missing.status, reason: missing.reason}, head: {sha: "b" * 40},
                  suites: %w[json kv_fake], rounds: 1, metadata: metadata, rows: [], skipped: []}
      check.call("comment heading names the suites", comment(rendered).lines.first.start_with?("### Benchmarks of json, kv_fake: "),
                 true)
      note = "Every case is new: check-perf-no-such-revision cannot be resolved: "
      check.call("unresolvable base rendered", [report(rendered).include?(note), comment(rendered).include?(note)],
                 [true, true])
    end

    Dir.mktmpdir("check-perf-comment") do |tmp|
      minimal = {"base" => {"sha" => "a" * 40, "status" => "built"}, "head" => {"sha" => "b" * 40}, "suites" => ["x"],
                 "rounds" => 7, "metadata" => {}, "rows" => [], "skipped" => []}
      dir = lambda do |name, number: nil, text: JSON.generate(minimal)|
        File.join(tmp, name).tap do |d|
          FileUtils.mkdir_p(d)
          File.write(File.join(d, "result.json"), text) if text
          File.write(File.join(d, "pr-number"), number) if number
        end
      end
      ["12; rm", "0", "", "-1", "012", "1\n\n"].each do |bad|
        d = dir.call("bad", number: bad)
        check.call("comment_rejects_bad_number #{bad.inspect}", status.call { pr_number([d]) }, 3)
      end
      check.call("pr-number trailing newline", pr_number([dir.call("good", number: "42\n")]), 42)
      check.call("pr-number from the first dir that has one", pr_number([dir.call("none"), dir.call("second", number: "7")]), 7)
      check.call("pr-number missing", status.call { pr_number([dir.call("none")]) }, 3)
      check.call("comment_truncates", [comment_body(["x" * 70_000]).length <= BODY_LIMIT, comment_body(["x" * 70_000]).end_with?(TRUNCATED)],
                 [true, true])
      check.call("comment_marker_first", comment_body(["a", "b"]), "#{MARKER}\na\n\nb\n")
      check.call("comment_marker_first untrusted text", comment_body(["#{MARKER}\n"]).start_with?("#{MARKER}\n#{MARKER}"), true)

      calls = []
      existing = []
      http = lambda do |verb, path, body = nil|
        calls << [verb, path, body]
        case path
        when %r{/pulls/} then {"head" => {"sha" => "abc"}}
        when %r{/comments\?per_page=100&page=(\d+)} then existing[Regexp.last_match(1).to_i - 1] || []
        else {"id" => 1}
        end
      end
      env = {"GITHUB_REPOSITORY" => "o/r", "HEAD_SHA" => "abc"}
      d = dir.call("run", number: "5")
      quietly = lambda do |**kw|
        out = $stdout
        $stdout = StringIO.new
        post_comment([d, File.join(tmp, "absent")], **kw)
      ensure
        $stdout = out
      end
      quietly_in_dir = lambda do |x|
        out = $stdout
        $stdout = StringIO.new
        post_comment([x], env: env, http: http)
      ensure
        $stdout = out
      end
      calls.clear
      check.call("comment creates", [quietly.call(env: env, http: http), calls.last[0, 2]], [0, [:post, "/repos/o/r/issues/5/comments"]])
      check.call("comment body marker", calls.last[2][:body].start_with?("#{MARKER}\n"), true)
      user = {"user" => {"login" => "mallory"}, "body" => "#{MARKER}\nplanted"}
      bot = {"id" => 99, "user" => {"login" => BOT_LOGIN}, "body" => "#{MARKER}\nold"}
      other = {"id" => 98, "user" => {"login" => BOT_LOGIN}, "body" => "unrelated"}
      existing.replace([[user, other]])
      calls.clear
      quietly.call(env: env, http: http)
      check.call("planted marker is not edited", calls.last[0], :post)
      existing.replace([[user] * 100, [other, bot]])
      calls.clear
      quietly.call(env: env, http: http)
      check.call("comment edits across pages", calls.last[0, 2], [:patch, "/repos/o/r/issues/comments/99"])
      calls.clear
      check.call("stale head sha", [quietly.call(env: env.merge("HEAD_SHA" => "def"), http: http), calls.map(&:first)], [0, [:get]])
      hostile = minimal.merge(
        "base" => {"sha" => "<script>", "status" => "built"}, "head" => {"sha" => "zz"},
        "suites" => ["x", "a`b"], "skipped" => ["s/t1", "[x](https://e.example)"],
        "metadata" => {"cpu" => {"model" => "Xeon &#64;team <img src=x onerror=alert(1)> @couchbase/team\nWWW.cpu.example"},
                       "compiler" => {"version" => "[cc](https://e.example) #42 owner/repo#7 &commat;x"}},
        "rows" => [{"key" => "evil`|<img src=x>&#64;team", "verdict" => "no change"},
                   {"key" => "bogus/verdict", "verdict" => "<b>slower</b>"},
                   {"key" => "good/t1", "verdict" => "slower", "reason" => "see #12 &#x40;org <i>x</i> www.r.example",
                    "base" => {"median" => "1e3"}, "head" => {"median" => "INFINITE"},
                    "ratio" => {"median" => 1.1, "lower" => 1.05, "upper" => "x"},
                    "throughput" => {"verdict" => "faster", "base" => {"median" => "1e6"}, "head" => {"median" => 2.0e6},
                                     "ratio" => {"median" => "x"}}}]
      )
      # JSON.parse reads 1e400 as Infinity, which JSON.generate refuses to write.
      rendered_hostile = comment(comment_result(JSON.parse(JSON.generate(hostile).sub('"INFINITE"', "1e400"))))
      check.call("hostile result renders none of its payload",
                 ["<", "&", "#4", "#1", "#7", "`|", "](", "@couchbase", "@team", "bogus", "a`b", "zz"].reject { |p| !rendered_hostile.include?(p) } +
                   rendered_hostile.scan(/www\./i),
                 [])
      check.call("hostile result keeps the valid rows",
                 [rendered_hostile.include?("| `good/t1` | - | - | +10.0% | slower (see 12 x40org ix/i www\u200b.r.example) | - | - | - | - | - | 2.00M | - | faster |\n"),
                  rendered_hostile.include?("`s/t1`"), rendered_hostile.include?("base `?`, head `?`")],
                 [true, true, true])
      check.call("cpu verdict outside the known set left out",
                 comment_row("key" => "c/t1", "verdict" => "no change",
                             "cpu" => {"verdict" => "<b>faster</b>", "ratio" => {"median" => 0.75}})[:cpu].values_at(:verdict, :ratio),
                 [nil, {median: 0.75, lower: nil, upper: nil}])
      check.call("comment_result not a result", status.call { comment_result([]) }, 3)
      check.call("comment_result rows not an array", status.call { comment_result(minimal.merge("rows" => {})) }, 3)
      check.call("plain", [plain("a@b <c>&#64;"), plain(""), plain(5), plain("x" * 300).length, plain("see www.x.example")],
                 ["a@\u200bb c64", nil, nil, TEXT_LIMIT, "see www\u200b.x.example"])
      check.call("malformed result.json fails", status.call { quietly_in_dir.call(dir.call("broken", number: "5", text: "{")) }, 3)
      check.call("no HEAD_SHA", status.call { quietly.call(env: {"GITHUB_REPOSITORY" => "o/r"}, http: http) }, 3)
      quietly_in = lambda do |x|
        out = $stdout
        $stdout = StringIO.new
        post_comment([x], env: {}, http: http)
      ensure
        $stdout = out
      end
      empty = File.join(tmp, "empty")
      FileUtils.mkdir_p(empty)
      calls.clear
      check.call("no result.json", [quietly_in.call(empty), calls], [0, []])
      File.symlink("/etc/hostname", File.join(empty, "result.json"))
      check.call("symlink ignored", artifact_file(empty, "result.json"), nil)
    end

    meta = metadata
    check.call("metadata_shape", meta.keys.sort, %i[build_type compiler cpu disk memory network os runner])
    check.call("metadata_shape cpu", meta[:cpu].keys.sort, %i[governor logical_cores model physical_cores smt])
    # A field the machine does not provide, such as the CPU model on some ARM kernels, is nil; one
    # it provides has its type.
    check.call("metadata_shape cpu types",
               [meta[:cpu][:model], meta[:cpu][:logical_cores], meta[:cpu][:physical_cores]]
                 .zip([String, Integer, Integer]).all? { |v, t| v.nil? || v.is_a?(t) }, true)
    check.call("metadata_shape memory types", meta[:memory].values.all? { |v| v.nil? || v.is_a?(Integer) }, true)

    likely = {base: {sha: "a" * 40, status: "built"}, head: {sha: "b" * 40}, suites: ["x"], rounds: 7, metadata: meta,
              skipped: [], rows: [integer_row]}
    unchanged = likely.merge(rows: [row("a", rounds.call("a", 10.0), rounds.call("a", 10.0))])
    hint = "A likely row is a hint to re-run: with 7 rounds an unchanged key reads likely with probability at most 2/128."
    check.call("likely noted", [report(likely).include?(hint), comment(likely).include?(hint)], [true, true])
    # ci_ranks(9) is [1, 7], so the bound is 2 * (1 + 9) / 512.
    check.call("likely noted at 9 rounds", report(likely.merge(rounds: 9)).include?("with 9 rounds an unchanged key reads likely " \
                                                                                    "with probability at most 20/512."), true)
    check.call("likely not noted without a CI", [likely_rate(5), report(likely.merge(rounds: 5)).include?("A likely row")], [nil, false])
    check.call("likely not noted", [report(unchanged).include?(hint), comment(unchanged).include?(hint)], [false, false])
    cpu_likely = likely.merge(rows: [row("a", with_cpu.call("a", 10.0, 100.0), with_cpu.call("a", 10.0, 99.0))])
    check.call("cpu likely noted", [cpu_likely[:rows][0][:cpu][:verdict], report(cpu_likely).include?(hint)], ["likely faster", true])
    columns = [report(cpu_row_result = likely.merge(rows: [cpu_row])), comment(cpu_row_result)]
    check.call("cpu columns render", columns.map { |t| CPU_HEADER.all? { |h| t.include?(h) } && t.include?("-25.0% [-25.0%, -25.0%]") },
               [true, true])
    check.call("cpu columns absent", report(unchanged).lines.last.split.last(4), ["-"] * 4)
    columns = [report(more_result = likely.merge(rows: [more])), comment(more_result)]
    check.call("throughput columns render",
               columns.map { |t| THROUGHPUT_HEADER.all? { |h| t.include?(h) } && t.include?("+25.0% [+25.0%, +25.0%]") }, [true, true])

    sample = {base: {sha: "a" * 40, status: "built"}, head: {sha: "b" * 40}, suites: ["x"], rounds: 5, metadata: meta, skipped: [],
              rows: Array.new(5000) { |i| row("case_#{i}/v", rounds.call("x", 10.0), rounds.call("x", 10.0)) }}
    raise "comment over the limit" unless comment(sample).length <= COMMENT_LIMIT + 100
    Dir.mktmpdir do |tmp|
      Dir.mkdir(File.join(tmp, "abi"))
      Dir.mkdir(File.join(tmp, "perf"))
      Dir.mkdir(File.join(tmp, "empty"))
      File.write(File.join(tmp, "abi", "index.html"), "")
      File.write(File.join(tmp, "perf", "index.html"), "")
      html = PagesSite.render_index(tmp)
      check.call("site_index_lists_dirs", [html.include?(%(href="abi/">ABI history)), html.include?(%(href="perf/">Performance history)),
                                           html.include?("empty")], [true, true, false])

      quiet = lambda do |&block|
        out = [$stdout, $stderr]
        $stdout = $stderr = StringIO.new
        block.call
      ensure
        $stdout, $stderr = out
      end
      bare = lambda do |name|
        File.join(tmp, name).tap { |d| run("git", "init", "--quiet", "--bare", d, quiet: true) }
      end

      # The first push is rejected, as by a concurrent publish; the second succeeds.
      racy = bare.call("racy.git")
      hook = File.join(racy, "hooks", "pre-receive")
      File.write(hook, "#!/bin/sh\nn=\"$(pwd)/rejected\"\n[ -f \"$n\" ] && exit 0\ntouch \"$n\"\nexit 1\n")
      File.chmod(0o755, hook)
      runs = 0
      quiet.call do
        check.call("retry pushed", PagesSite.publish(url: racy, token: nil, site: File.join(tmp, "s1"), message: "m") do |dir|
          runs += 1
          File.write(File.join(dir, "x"), "x")
        end, true)
      end
      check.call("retry reruns the change", runs, 2)
      check.call("retry content", run("git", "-C", racy, "show", "#{PagesSite::REF}:x", quiet: true), "x")
      always = bare.call("always.git")
      File.write(File.join(always, "hooks", "pre-receive"), "#!/bin/sh\nexit 1\n")
      File.chmod(0o755, File.join(always, "hooks", "pre-receive"))
      failure = quiet.call do
        PagesSite.publish(url: always, token: nil, site: File.join(tmp, "s2"), message: "m", attempts: 2) { |d| File.write(File.join(d, "x"), "x") }
      rescue PagesSite::Error => e
        e.message
      end
      check.call("retry gives up", failure, "could not push to #{PagesSite::REF}")

      repo = File.join(tmp, "repo")
      remote = bare.call("remote.git")
      run("git", "init", "--quiet", repo, quiet: true)
      shas = ["2026-01-01T00:00:00Z", "2026-02-01T00:00:00Z"].map do |date|
        ENV["GIT_COMMITTER_DATE"] = date
        run("git", "-C", repo, "-c", "user.name=t", "-c", "user.email=t@example.com", "commit", "--quiet",
            "--allow-empty", "-m", date, quiet: true)
        run("git", "-C", repo, "rev-parse", "HEAD", quiet: true).strip
      ensure
        ENV.delete("GIT_COMMITTER_DATE")
      end
      older, newer = shas
      write_result = lambda do |name, sha, rows, cpu|
        d = File.join(tmp, "#{name}-#{sha[0, 7]}-#{Dir.children(tmp).size}")
        Dir.mkdir(d)
        File.write(File.join(d, "result.json"), JSON.generate("head" => {"sha" => sha}, "metadata" => {"cpu" => {"model" => cpu}}, "rows" => rows))
        d
      end
      stat = ->(m) { {"median" => m, "lower" => m, "upper" => m} }
      dirs_for = lambda do |sha|
        [write_result.call("a", sha, [{"key" => "k/1", "verdict" => "no change", "head" => stat.call(5.0).merge("extra" => 1),
                                       "cpu" => {"head" => stat.call(3.0)}, "max_rss_bytes" => {"head" => 1024},
                                       "throughput" => {"head" => stat.call(2_500.0)}},
                                      {"key" => "bad", "verdict" => "failed", "head" => stat.call(1.0)},
                                      {"key" => "gone", "verdict" => "removed", "head" => nil}], "Model X"),
         File.join(tmp, "missing"),
         write_result.call("b", sha, [{"key" => "c/2", "verdict" => "new", "head" => stat.call(7.0)}], "Model Y"),
         write_result.call("old", "f" * 40, [{"key" => "stale/1", "verdict" => "new", "head" => stat.call(9.0)}], "Model Z")]
      end
      Dir.chdir(repo) do
        [newer, older].each { |sha| quiet.call { check.call("publish status", publish(sha, dirs_for.call(sha), url: remote, token: nil), 0) } }
      end
      show = ->(path) { run("git", "-C", remote, "show", "#{PagesSite::REF}:#{path}", quiet: true) }
      index = JSON.parse(show.call("perf/data/index.json"))
      check.call("publish_appends_index", [index.map { |e| e["sha"] }, index.first["cpu_model"]], [[newer, older], "Model X"])
      data = JSON.parse(show.call("perf/data/#{older}.json"))
      check.call("publish rows", data["rows"], {"c/2" => stat.call(7.0).merge("cpu_model" => "Model Y"),
                                                "k/1" => stat.call(5.0).merge("cpu_model" => "Model X", "cpu_ns_per_op" => 3.0,
                                                                              "max_rss_bytes" => 1024, "ops_per_second" => 2_500.0)})
      check.call("publish pages", [show.call("perf/index.html").include?(%(REPO_URL = "https://github.com/#{repository}")),
                                   show.call("index.html").include?(%(href="perf/">))], [true, true])

      ref = File.join(tmp, "ref")
      FileUtils.mkdir_p([File.join(ref, "perf", "data"), File.join(ref, "abi", "reports", "c"), File.join(ref, "other")])
      File.write(File.join(ref, "perf", "data", "index.json"), "[]")
      File.write(File.join(ref, "perf", "data", "notes.txt"), "x")
      File.write(File.join(ref, "perf", "index.html"), "<script>pushed</script>")
      File.write(File.join(ref, "index.html"), "<script>pushed</script>")
      File.write(File.join(ref, "other", "index.html"), "<script>pushed</script>")
      File.write(File.join(ref, "abi", "index.html"), "<script>pushed</script>")
      File.write(File.join(ref, "abi", "reports", "c", "report-x.txt"), "r")
      commit = "c" * 40
      FileUtils.mkdir_p([File.join(ref, "abi", "reports", commit), File.join(ref, "abi", "reports", "C" * 40)])
      File.write(File.join(ref, "abi", "reports", commit, "report-previous-commit-1234567.txt"), "r")
      File.write(File.join(ref, "abi", "reports", commit, "x.html"), "<script>pushed</script>")
      File.write(File.join(ref, "abi", "reports", "C" * 40, "report-x.txt"), "r")
      File.symlink("/etc/hostname", File.join(ref, "abi", "reports", commit, "link.txt"))
      out = File.join(tmp, "deployed")
      abi_calls = []
      stub_abi = lambda do |file, reports_dir|
        abi_calls << [file, Dir.glob("*/*", base: reports_dir).sort]
        File.write(file, "rendered")
      end
      render_site(ref, out, abi_page: stub_abi)
      deployed = Dir.glob("**/*", base: out).select { |f| File.file?(File.join(out, f)) }.sort
      check.call("render_site takes data only", deployed,
                 %W[abi/index.html abi/reports/#{commit}/report-previous-commit-1234567.txt index.html perf/data/index.json
                    perf/index.html])
      check.call("render_site renders the ABI page from the copied reports",
                 [abi_calls, File.read(File.join(out, "abi", "index.html"))],
                 [[[File.join(out, "abi", "index.html"), ["#{commit}/report-previous-commit-1234567.txt"]]], "rendered"])
      outside = File.join(tmp, "outside")
      FileUtils.mkdir_p(outside)
      File.write(File.join(outside, "secret.json"), "{}")
      linked = lambda do |link, target|
        r = File.join(tmp, "linked-#{Dir.children(tmp).size}")
        FileUtils.mkdir_p(File.join(r, File.dirname(link)))
        File.symlink(target, File.join(r, link))
        r
      end
      File.write(File.join(outside, "report-x.txt"), "r")
      [["perf", outside], ["perf/data", outside], ["perf/data/secret.json", File.join(outside, "secret.json")],
       ["abi", outside], ["abi/reports", outside], ["abi/reports/#{commit}", outside],
       ["abi/reports/#{commit}/report-x.txt", File.join(outside, "report-x.txt")]].each do |link, target|
        check.call("render_site refuses a symlinked #{link}",
                   status.call { render_site(linked.call(link, target), File.join(tmp, "linked-out"), abi_page: stub_abi) }, 3)
      end
      check.call("render_site renders the pages", [File.read(File.join(out, "perf", "index.html")) == perf_page,
                                                   File.read(File.join(out, "index.html")) == PagesSite.render_index(out)], [true, true])

      message = lambda do |json|
        d = File.join(tmp, "bad#{rand(1 << 30)}")
        Dir.mkdir(d)
        File.write(File.join(d, "result.json"), json)
        push_data(newer, "2026-02-01T00:00:00Z", [d])
        nil
      rescue Error => e
        e.message
      end
      check.call("not an object", message.call("[]").nil?, false)
      check.call("not json", message.call("{").nil?, false)
      row = ->(head) { JSON.generate("head" => {"sha" => newer}, "rows" => [{"key" => "k", "head" => head}]) }
      check.call("non-numeric median", message.call(row.call({"median" => "5", "lower" => 1, "upper" => 2})).nil?, false)
      malformed = File.join(tmp, "malformed")
      Dir.mkdir(malformed)
      File.write(File.join(malformed, "result.json"),
                 JSON.generate("head" => {"sha" => newer}, "rows" => [{"key" => "k", "head" => stat.call(1.0), "cpu" => "x", "max_rss_bytes" => {"head" => "1"},
                                                    "throughput" => {"head" => {"median" => "1"}}}]))
      check.call("malformed cpu, rss and throughput left out", push_data(newer, "2026-02-01T00:00:00Z", [malformed])["rows"], {"k" => stat.call(1.0).merge("cpu_model" => nil)})
      check.call("symlinked result ignored", begin
        d = File.join(tmp, "link")
        Dir.mkdir(d)
        File.symlink(Dir.glob(File.join(tmp, "a-*", "result.json")).first, File.join(d, "result.json"))
        push_data(newer, "2026-02-01T00:00:00Z", [d])["rows"]
      end, {})
    end

    puts "ok"
    0
  end

  def self.main(argv)
    rounds = ROUNDS
    suites = []
    out = "perf-report"
    parser = OptionParser.new do |o|
      o.banner = "usage: bin/check-perf {metadata [BUILD] | build REV DIR | compare BASE HEAD | ci | comment DIR... | publish COMMIT DIR... | site FROM TO | --self-test}"
      o.on("--rounds N", Integer, "rounds of compare (default #{ROUNDS})") { |n| rounds = n }
      o.on("--suite NAME", "a binary benchmark_NAME to compare; repeatable (default all)") { |s| suites << s }
      o.on("--out DIR", "where compare writes its reports (default #{out})") { |d| out = d }
    end
    return self_test if argv.delete("--self-test")

    command, *args = parser.parse(argv)
    case command
    when "metadata"
      raise Error, parser.banner unless args.size <= 1

      puts JSON.pretty_generate(metadata(args[0] || "build"))
      0
    when "build"
      raise Error, parser.banner unless args.size == 2

      puts build(args[0], args[1])
      0
    when "compare"
      raise Error, parser.banner unless args.size == 2 && rounds.positive?

      compare(args[0], args[1], rounds: rounds, suites: suites, out: out)
    when "comment"
      raise Error, parser.banner if args.empty?

      post_comment(args)
    when "publish"
      raise Error, parser.banner if args.size < 2

      publish(args[0], args[1..])
    when "site"
      raise Error, parser.banner unless args.size == 2

      render_site(args[0], args[1])
      0
    when "ci"
      raise Error, parser.banner unless args.empty? && rounds.positive?

      ci(rounds: rounds, suites: suites, out: out)
    else
      raise Error, parser.banner
    end
  rescue OptionParser::ParseError => e
    warn e.message
    3
  rescue Error => e
    warn e.message
    e.status
  rescue StandardError => e
    warn e.full_message
    3
  end
end

exit CheckPerf.main(ARGV) if $PROGRAM_NAME == __FILE__

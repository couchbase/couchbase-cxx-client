# Reports symbols of the statically linked AWS-LC that the shared library exports.
#
# A statically linked TLS library must not reach the shared library's dynamic symbol table. AWS-LC
# annotates every public function OPENSSL_EXPORT, and in a static build that expands to
# visibility("default") on every platform except Windows (include/openssl/base.h), which
# CMAKE_C_VISIBILITY_PRESET cannot override. The whole OpenSSL name set is then exported, and a
# process that also loads a gRPC or libcurl bound to the platform OpenSSL holds two implementations
# under one set of names: calls bind across them and crash on first use. BoringSSL defined the macro
# empty for a static build, so nothing here needed the guard before.
#
# A TLS symbol is any external symbol AWS-LC's own libcrypto.a and libssl.a define, read from the
# archives in the build tree, so no list of names can fall behind the library.
#
#   ./bin/check-exported-symbols [build-dir]
#
# Exit 0 when the library exports none of them, or when the configuration builds no shared library
# or links no static AWS-LC.
# Exit 1 when names are exported -- CMakeLists.txt hides them per platform at the link step.
# Exit 2 when the answer could not be determined, which is not the same as a clean result.

BUILD = ARGV[0] || "cmake-build-tests"

# Ruby exits 1 on an uncaught exception, which would read as "names are exported".
at_exit { exit 2 if $! && !$!.is_a?(SystemExit) }

# Both the archives and the client define standard library code inline: instantiations in namespace
# std and the global operator new and delete. They are not TLS names.
# cmake/UnexportedTlsSymbols.cmake applies the same rule to the Apple linker's list.
STD_INSTANTIATION = /\A_Z(?:(?:NK?|T[VIS]N?)?St|nw|na|dl|da)/

def bail(message)
  warn "check-exported-symbols: #{message}"
  exit 2
end

def which(name)
  ENV.fetch("PATH", "").split(File::PATH_SEPARATOR).each do |dir|
    path = File.join(dir, name)
    return path if File.executable?(path) && !File.directory?(path)
  end
  nil
end

# "<addr> <type> <name>" or " <type> <name>" when the address is absent. An archive adds a
# "member.o:" line per member. Mach-O prefixes every C symbol with an underscore; ELF does not.
def symbol_names(tool, args, path, mach_o)
  output = begin
    IO.popen([tool, *args, path], err: File::NULL, &:read)
  rescue SystemCallError => e
    bail("#{tool}: #{e.message}")
  end
  bail("#{tool} #{args.join(' ')} #{path} failed") unless $?.success?

  output.lines.filter_map do |line|
    fields = line.split(/\s+/).reject(&:empty?)
    next if fields.size < 2

    name = fields[-1]
    mach_o && name.start_with?("_") ? name[1..] : name
  end
end

bail("build directory #{BUILD.inspect} does not exist") unless File.directory?(BUILD)

# The extension, not the platform: a cross build names the object format, and Ruby's host does not.
patterns = ["libcouchbase_cxx_client.so.*", "libcouchbase_cxx_client.*.dylib",
            "couchbase_cxx_client.dll", "libcouchbase_cxx_client.dll"]
# Resolved and deduplicated rather than filtered on File.symlink?: which of the three names is the
# real file and which are links to it differs between platforms and generators.
candidates = patterns.flat_map { |glob| Dir.glob(File.join(BUILD, "**", glob)) }
dangling = candidates.reject { |path| File.exist?(path) }
bail("#{dangling.join(', ')} points at nothing; the build is incomplete") unless dangling.empty?
library = candidates
          .map { |path| File.realpath(path) }
          .uniq
          .min_by { |path| [path.count(File::SEPARATOR), path.length] }

if library.nil?
  # Not a failure: COUCHBASE_CXX_CLIENT_BUILD_SHARED=OFF builds only the archive, and an archive is
  # meant to carry these symbols -- whoever links it resolves them once.
  puts "skip: no shared library under #{BUILD}, nothing to check"
  exit 0
end

if library.end_with?(".dll")
  # Windows exports only what __declspec(dllexport) or a .def file names, and AWS-LC's static path
  # defines OPENSSL_EXPORT empty there, so the hazard cannot arise.
  puts "skip: #{library} is a PE image, which exports nothing by visibility attribute"
  exit 0
end

awslc_builds = Dir.glob(File.join(BUILD, "**", "awslc-build"))
if awslc_builds.empty?
  puts "skip: no statically linked AWS-LC under #{BUILD}, nothing to check"
  exit 0
end
archives = awslc_builds.flat_map { |dir| Dir.glob(File.join(dir, "{crypto,ssl}", "lib{crypto,ssl}.a")) }
# A tree that builds AWS-LC but holds neither archive would otherwise report every library clean.
bail("#{awslc_builds.join(', ')} holds no libcrypto.a and libssl.a") if archives.size < 2

nm = ENV["NM"] || which("nm") || which("llvm-nm")
bail("no nm on PATH; set NM to one that reads this object format") if nm.nil?

mach_o = library.end_with?(".dylib")
# -D reads the dynamic table an ELF consumer actually binds against; Mach-O has no equivalent, so
# external+defined is the closest question there.
args = mach_o ? ["-g", "--defined-only"] : ["-D", "--defined-only"]
exported = symbol_names(nm, args, library, mach_o)
bail("#{nm} reported no exported symbols at all for #{library}") if exported.empty?

tls = archives.flat_map { |archive| symbol_names(nm, ["-g", "--defined-only"], archive, mach_o) }
              .grep_v(STD_INSTANTIATION)
              .to_set
bail("#{nm} reported no defined symbols in #{archives.join(', ')}") if tls.empty?

leaked = exported.select { |name| tls.include?(name) }.uniq.sort

if leaked.empty?
  # The totals are part of the result: "none" means nothing without evidence that both were read.
  puts "ok: #{library} exports #{exported.size} symbol(s), none of the #{tls.size} AWS-LC defines"
  exit 0
end

puts "#{library} exports #{leaked.size} AWS-LC symbol(s) of #{exported.size}:"
leaked.first(20).each { |name| puts "  #{name}" }
puts "  ... and #{leaked.size - 20} more" if leaked.size > 20
puts
puts "A statically linked TLS library is reaching the dynamic symbol table. Hide it at the link"
puts "step for this platform in CMakeLists.txt, next to the --exclude-libs already there for ELF."
exit 1

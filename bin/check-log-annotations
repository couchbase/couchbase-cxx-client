# Checks that potentially sensitive values passed to the CB_LOG_* macros are wrapped in the
# redaction helpers from core/logger/redaction.hxx, so an external tool can strip or hash them:
#
#   <ud> couchbase::core::logger::user_data()    document keys and bodies, query statements,
#                                                usernames, e-mail addresses, xattrs
#   <md> couchbase::core::logger::metadata()     bucket / scope / collection names, index and
#                                                design document names, cluster names
#   <sd> couchbase::core::logger::system_data()  hostnames, IP addresses, ports, DNS topology
#
# A composite value whose parts do not share one category is wrapped by a helper that applies
# several tags at once, and counts as annotated here without a category of its own:
#
#   couchbase::core::logger::document()           a document id, from core/document_id_fmt.hxx:
#                                                 <md> bucket, scope and collection, <ud> key
#
# Usage:
#   bin/check-log-annotations              # check, non-zero exit if anything is unannotated
#   bin/check-log-annotations --catalog    # inventory every log statement, for tracking drift
#   bin/check-log-annotations --self-test  # check the analysis itself against a fixture
#   bin/check-log-annotations core/io      # restrict the scan to some paths
#
# This is a heuristic. It reads argument expressions, not types, so it can only guess at what a
# value holds from what it is called -- it surfaces candidates for review, it does not decide.
# Suppress a reviewed false positive either with a "no-redact" comment on the log statement, or
# with an entry in the suppressions file (see SUPPRESSIONS_FILE below).

require "optparse"
require "find"

module LogAnnotations
  SUPPRESSIONS_FILE = ".log_redaction_suppressions.txt"

  # Identifiers are compared in a canonical form: leading and trailing underscores stripped
  # (the member convention is noise here), downcased. Defined before the tables below because
  # they are normalised as they are built.
  def self.normalise(identifier)
    identifier.gsub(/\A_+|_+\z/, "").downcase
  end

  # Macros that format their arguments through fmt, and can therefore carry annotations.
  FORMATTING_MACROS = %w[
    CB_LOG_TRACE CB_LOG_DEBUG CB_LOG_INFO CB_LOG_WARNING CB_LOG_ERROR CB_LOG_CRITICAL
  ].freeze

  # COUCHBASE_LOG_RAW deliberately skips fmt ("msg is already a string; deliver it directly"),
  # so the redaction wrappers cannot be used there. CB_LOG_PROTOCOL dumps raw protocol traffic
  # and is out of scope by design. Both are catalogued, neither is checked.
  UNCHECKED_MACROS = (FORMATTING_MACROS.map { |m| "#{m}_RAW" } + %w[CB_LOG_PROTOCOL]).freeze

  ALL_MACROS = (FORMATTING_MACROS + UNCHECKED_MACROS).freeze

  MACRO_PATTERN = /\b(#{ALL_MACROS.join('|')})\b/.freeze

  WRAPPERS = {
    "user_data" => "ud",
    "metadata" => "md",
    "system_data" => "sd",
  }.freeze

  # Helpers that tag a composite value with more than one category, so they map to no single tag.
  # They still mark their argument as annotated.
  COMPOSITE_WRAPPERS = %w[document].freeze

  WRAPPER_NAMES = (WRAPPERS.keys + COMPOSITE_WRAPPERS).freeze

  SOURCE_EXTENSIONS = %w[.cxx .hxx .cpp .hpp].freeze

  # Directories that never ship to a customer, or that we do not own.
  EXCLUDED_DIRS = %w[build third_party test cmake-build-debug cmake-build-release].freeze

  # Identifiers that are pre-tagged, SDK-generated, or otherwise known not to carry customer
  # data. Checked before the sensitive rules, so an entry here always wins. Compared after
  # normalisation, so trailing underscores need not be spelled out.
  #
  # The log_prefix family is pre-tagged rather than harmless: connection-context prefixes are
  # formatted once, at construction, by the sites listed in section 4a of
  # .ai_discussions/log_redaction/PLAN.md, and already carry their own <md>/<sd> tags by the
  # time they reach a log statement.
  #
  # "id" is absent on purpose -- see contextual_category.
  NEVER_SENSITIVE = %w[
    log_prefix prefix
    client_id session_id sdk_id opaque client_context_id operation_id
    key_value kv
    ec error error_code errc status status_code error_message message reason
    size length count offset seqno vbucket vbucket_id partition rev_str config_rev
    timeout duration elapsed backoff interval attempt attempts retries
    service service_type level network
  ].map { |token| normalise(token) }.freeze

  # Rules are matched against the normalised identifier tokens of an argument expression:
  # trailing/leading underscores stripped, downcased. Exact matches only -- prefix matching
  # turns key_value into a document key and keyspace into a document key too.
  SENSITIVE_TOKENS = {
    # "value" is deliberately absent. Every occurrence in this codebase is std::optional::value(),
    # std::error_code::value() or tao::json::value -- not one of them a document body. Document
    # payloads here are called body, payload, content or document.
    "user_data" => %w[
      key document_key doc_key document_id doc_id
      statement statements query query_string
      body payload content document doc
      xattr xattrs
      username user_name user email e_mail
    ].freeze,
    "metadata" => %w[
      bucket bucket_name buckets
      scope scope_name collection collection_name collection_path keyspace
      cluster_name server_group
      index_name design_document design_document_name ddoc ddoc_name view view_name
      replication_stream
      name path
    ].freeze,
    "system_data" => %w[
      host hostname hosts hostnames
      address addresses remote_address local_address bootstrap_address
      endpoint endpoints
      port ports remote_port local_port
      ip ip_address node nodes get_nodes
      dns srv srv_record nameserver nameservers
      connection_string config_text
    ].freeze,
  }.freeze

  # Identifier suffixes, applied after the exact-match tables. "*_hostname" is a hostname
  # regardless of what precedes it; "*_key" is not necessarily a document key, so it is absent.
  SENSITIVE_SUFFIXES = {
    "metadata" => %w[_bucket_name _scope_name _collection_name _index_name _ddoc_name].freeze,
    "system_data" => %w[_hostname _host _address _endpoint _port].freeze,
  }.freeze

  CPP_KEYWORDS = %w[
    static_cast dynamic_cast const_cast reinterpret_cast sizeof alignof decltype typeid
    true false nullptr this auto const static inline template typename operator return
    if else for while do switch case break continue new delete throw try catch
    int long short char bool float double void unsigned signed size_t std fmt
  ].freeze

  # A single argument of a single log statement.
  Argument = Struct.new(:text, :offset, keyword_init: true)

  # A single CB_LOG_* invocation.
  Statement = Struct.new(:file, :line, :macro, :format_string, :arguments, :source,
                         :suppressed, keyword_init: true)

  Finding = Struct.new(:file, :line, :macro, :identifier, :category, :argument,
                       :format_string, keyword_init: true)

  # Replaces the contents of comments and string/character literals with spaces, keeping every
  # byte offset and newline intact. Structural scanning (paren matching, argument splitting)
  # runs over this shadow copy, while reported text is sliced out of the original source. That
  # is what keeps a comma inside a format string from splitting an argument list.
  def self.shadow(source)
    out = source.dup
    i = 0
    length = source.length
    while i < length
      char = source[i]
      case char
      when "/"
        if source[i + 1] == "/"
          i = blank_until(out, source, i, "\n", inclusive: false)
          next
        elsif source[i + 1] == "*"
          i = blank_until(out, source, i + 2, "*/", inclusive: true)
          next
        end
      when '"'
        i = blank_string(out, source, i)
        next
      when "'"
        # Not a character literal when it is a C++14 digit separator, as in 1'000'000.
        unless i.positive? && source[i - 1].match?(/[0-9a-zA-Z_]/)
          i = blank_char_literal(out, source, i)
          next
        end
      end
      i += 1
    end
    out
  end

  # Blanks everything from `from` up to `terminator`, preserving newlines. Returns the offset
  # just past the terminator when `inclusive`, otherwise the offset of the terminator.
  def self.blank_until(out, source, from, terminator, inclusive:)
    stop = source.index(terminator, from) || source.length
    (from...stop).each do |j|
      out[j] = " " unless source[j] == "\n"
    end
    return stop unless inclusive

    (stop...[stop + terminator.length, source.length].min).each { |j| out[j] = " " }
    stop + terminator.length
  end

  # Handles both ordinary "..." literals and raw R"delim( ... )delim" literals.
  def self.blank_string(out, source, start)
    if start.positive? && source[start - 1] == "R"
      close_paren = source.index("(", start + 1)
      if close_paren
        delimiter = source[(start + 1)...close_paren]
        terminator = ")#{delimiter}\""
        stop = source.index(terminator, close_paren) || source.length
        ((start + 1)..[stop + terminator.length - 1, source.length - 1].min).each do |j|
          out[j] = " " unless source[j] == "\n"
        end
        return stop + terminator.length
      end
    end

    i = start + 1
    while i < source.length
      break if source[i] == '"'

      i += (source[i] == "\\" ? 2 : 1)
    end
    ((start + 1)...[i, source.length].min).each do |j|
      out[j] = " " unless source[j] == "\n"
    end
    i + 1
  end

  def self.blank_char_literal(out, source, start)
    i = start + 1
    while i < source.length
      break if source[i] == "'"

      i += (source[i] == "\\" ? 2 : 1)
    end
    ((start + 1)...[i, source.length].min).each { |j| out[j] = " " }
    i + 1
  end

  # Finds the offset of the parenthesis matching the one at `open`, over a shadow copy.
  def self.matching_paren(shadowed, open)
    depth = 0
    i = open
    while i < shadowed.length
      case shadowed[i]
      when "(" then depth += 1
      when ")"
        depth -= 1
        return i if depth.zero?
      end
      i += 1
    end
    nil
  end

  # Splits an argument list at top-level commas. Angle brackets are deliberately not tracked:
  # telling a template argument list from a comparison needs a real parser, and template
  # arguments are vanishingly rare inside log statements.
  def self.split_arguments(source, shadowed, from, to)
    arguments = []
    depth = 0
    start = from
    (from...to).each do |i|
      case shadowed[i]
      when "(", "[", "{" then depth += 1
      when ")", "]", "}" then depth -= 1
      when ","
        if depth.zero?
          arguments << Argument.new(text: source[start...i], offset: start)
          start = i + 1
        end
      end
    end
    arguments << Argument.new(text: source[start...to], offset: start) if start < to
    arguments.each { |argument| argument.text = argument.text.strip }
    arguments.reject { |argument| argument.text.empty? }
  end

  # Byte ranges covered by a redaction wrapper call within an expression, so that an
  # identifier can be tested for membership rather than the whole argument being waved
  # through because it happens to mention a wrapper somewhere.
  def self.wrapped_ranges(shadowed)
    ranges = []
    WRAPPER_NAMES.each do |wrapper|
      shadowed.enum_for(:scan, /\b#{wrapper}\s*\(/).each do
        match_start = Regexp.last_match.begin(0)
        open = shadowed.index("(", match_start)
        close = open && matching_paren(shadowed, open)
        ranges << (match_start..close) if close
      end
    end
    ranges
  end

  # Identifier tokens of an expression, paired with their offsets. Member accesses are broken
  # apart, so req->key_ yields both "req" and "key_" and the sensitive half is still seen.
  def self.identifiers(expression)
    tokens = []
    expression.enum_for(:scan, /[A-Za-z_][A-Za-z0-9_]*/).each do
      tokens << [Regexp.last_match[0], Regexp.last_match.begin(0)]
    end
    tokens
  end

  # "id" names two unrelated things here, and only one of them is a document key:
  #
  #   session.id()  stream_->id()  cmd->id()   accessor on an SDK object, a generated identifier
  #   id_                                      private member of a cluster or session, likewise
  #   request.id    cmd->request.id    id      the document_id of a KV operation -- <ud>
  #
  # The call parentheses and the trailing underscore are what tell them apart, so this cannot be
  # decided from the identifier alone.
  def self.contextual_category(identifier, expression, offset)
    return nil unless identifier == "id"
    return nil if expression[(offset + identifier.length)..-1].to_s.lstrip.start_with?("(")

    "user_data"
  end

  # Members and accessors that project a sensitive object onto something harmless: the number
  # of endpoints is not an endpoint, and a node's position in the node list is not an address.
  BENIGN_PROJECTIONS = %w[size length count empty capacity max_size index].freeze

  # True when the identifier is immediately narrowed by one of those projections, as in
  # endpoints_.size() or node.index. Only the first hop is considered, so address_.hostname
  # stays flagged.
  def self.projected?(expression, offset, identifier)
    rest = expression[(offset + identifier.length)..-1].to_s
    match = rest.match(/\A\s*(?:\.|->)\s*([A-Za-z_][A-Za-z0-9_]*)/)
    !match.nil? && BENIGN_PROJECTIONS.include?(normalise(match[1]))
  end

  # True when an identifier is preceded by "::", i.e. it names a type or a namespace member
  # rather than a value in hand -- tao::json::value is the JSON library's node type, not a
  # document body. Member access through "." or "->" is not qualification in this sense:
  # session->hostname() really does log a hostname.
  def self.qualified?(expression, offset)
    expression[0...offset].rstrip.end_with?("::")
  end

  # Returns the wrapper an identifier ought to be passed through, or nil.
  def self.category_for(identifier, expression = "", offset = 0)
    contextual = contextual_category(identifier, expression, offset)
    return contextual unless contextual.nil?

    normalised = normalise(identifier)
    return nil if normalised.empty?
    return nil if CPP_KEYWORDS.include?(normalised)
    return nil if NEVER_SENSITIVE.include?(normalised)

    SENSITIVE_TOKENS.each do |wrapper, tokens|
      return wrapper if tokens.include?(normalised)
    end
    SENSITIVE_SUFFIXES.each do |wrapper, suffixes|
      return wrapper if suffixes.any? { |suffix| normalised.end_with?(suffix) }
    end
    nil
  end

  def self.line_of(source, offset)
    source[0...offset].count("\n") + 1
  end

  # Extracts every CB_LOG_* statement from one translation unit.
  def self.statements(path, source)
    shadowed = shadow(source)
    found = []
    shadowed.enum_for(:scan, MACRO_PATTERN).each do
      match = Regexp.last_match
      macro = match[1]
      start = match.begin(0)
      open = shadowed.index("(", start)
      next if open.nil? || !shadowed[(start + macro.length)...open].match?(/\A\s*\z/)

      close = matching_paren(shadowed, open)
      next if close.nil?

      arguments = split_arguments(source, shadowed, open + 1, close)
      format_string = arguments.first&.text
      found << Statement.new(
        file: path,
        line: line_of(source, start),
        macro: macro,
        format_string: format_string,
        arguments: arguments.drop(1),
        source: source[start..close],
        # The suppressing comment is usually written after the closing parenthesis, so the
        # window runs to the end of that line rather than to the parenthesis itself.
        suppressed: source[start..(source.index("\n", close) || source.length)]
          .match?(/\bno-redact\b/),
      )
    end
    found
  end

  def self.findings_for(statement, suppressed_identifiers)
    return [] if UNCHECKED_MACROS.include?(statement.macro)
    return [] if statement.suppressed

    statement.arguments.flat_map do |argument|
      # Analysed over a shadow copy, so that an identifier spelled inside a format string --
      # "hostname={}" -- is not mistaken for the value being logged.
      expression = shadow(argument.text)
      ranges = wrapped_ranges(expression)
      identifiers(expression).filter_map do |identifier, offset|
        next if ranges.any? { |range| range.cover?(offset) }
        next if qualified?(expression, offset)
        next if projected?(expression, offset, identifier)
        next if suppressed_identifiers.include?(normalise(identifier))

        category = category_for(identifier, expression, offset)
        next if category.nil?

        Finding.new(
          file: statement.file,
          line: statement.line,
          macro: statement.macro,
          identifier: identifier,
          category: category,
          argument: collapse(argument.text),
          format_string: collapse(statement.format_string.to_s),
        )
      end
    end
  end

  def self.collapse(text)
    text.gsub(/\s+/, " ").strip
  end

  def self.source_files(roots)
    files = []
    roots.each do |root|
      Find.find(root) do |path|
        if File.directory?(path)
          Find.prune if EXCLUDED_DIRS.include?(File.basename(path)) || File.basename(path).start_with?(".")
          next
        end
        files << path if SOURCE_EXTENSIONS.include?(File.extname(path))
      end
    end
    files.sort
  end

  # Suppressions file format, one entry per line, "#" starts a comment:
  #
  #   core/io/dns_client.cxx                 # skip the file entirely
  #   core/io/dns_client.cxx  port           # "port" is not sensitive in this file
  #   core/**                 service_name   # ... in every file under core/
  #
  # Identifiers are matched after normalisation, so trailing underscores are optional.
  def self.load_suppressions(path)
    files = []
    identifiers = []
    return [files, identifiers] unless File.file?(path)

    File.readlines(path).each do |line|
      line = line.sub(/#.*\z/, "").strip
      next if line.empty?

      glob, identifier = line.split(/\s+/, 2)
      if identifier.nil?
        files << glob
      else
        identifiers << [glob, normalise(identifier.strip)]
      end
    end
    [files, identifiers]
  end

  def self.matches_glob?(glob, path)
    File.fnmatch?(glob, path, File::FNM_PATHNAME) ||
      File.fnmatch?(glob, path) ||
      path.start_with?(glob.chomp("/"))
  end

  def self.print_catalog(statements)
    statements.each do |statement|
      arguments = statement.arguments.map { |argument| collapse(argument.text) }
      puts format("%s:%d\t%s\t%s\t%s",
                  statement.file,
                  statement.line,
                  statement.macro,
                  collapse(statement.format_string.to_s),
                  arguments.join(" | "))
    end
    warn "\n#{statements.size} log statements"
  end

  def self.print_findings(findings)
    findings.group_by(&:file).sort.each do |file, in_file|
      puts file
      in_file.sort_by { |finding| [finding.line, finding.identifier] }.each do |finding|
        wrapper = "couchbase::core::logger::#{finding.category}"
        puts format("  %s:%d  %s  <%s>",
                    file, finding.line, finding.identifier, WRAPPERS[finding.category])
        puts format("    argument: %s", finding.argument)
        puts format("    format:   \"%s\"", finding.format_string)
        puts format("    suggest:  wrap in %s()", wrapper)
      end
      puts
    end

    by_category = findings.group_by(&:category).map { |category, group| "#{group.size} <#{WRAPPERS[category]}>" }
    puts "#{findings.size} unannotated arguments (#{by_category.sort.join(', ')}) " \
         "in #{findings.map(&:file).uniq.size} files"
  end

  # Exercises the analysis against a fixture covering each way the previous prototype went
  # wrong. Kept in the script itself because there is no Ruby test harness in this repository,
  # and a parser this fiddly should not be the only thing standing between us and a silently
  # empty report.
  SELF_TEST_SOURCE = <<~CPP
    void f() {
      CB_LOG_DEBUG("host={}", hostname);
      CB_LOG_DEBUG("host={}", hostname); // no-redact: explained here
      CB_LOG_DEBUG("host={}", logger::system_data(hostname));
      CB_LOG_DEBUG_RAW("hostname literal");
      CB_LOG_DEBUG("a={}, b={}", logger::system_data(host), port);
      CB_LOG_DEBUG("s={}", "hostname in a string literal, and a comma");
      CB_LOG_DEBUG("hostname={}, port={}", h, p);
      CB_LOG_DEBUG(R"(raw "hostname" {})", bucket_name);
      CB_LOG_DEBUG("chained {}", session->bootstrap_hostname());
      CB_LOG_DEBUG("n={}", endpoints_.size());
      CB_LOG_DEBUG("k={}", request.id);
      CB_LOG_DEBUG("k={}", logger::document(request.id));
      CB_LOG_DEBUG("sid={}", session.id());
      CB_LOG_PROTOCOL("dump {}", body);
      CB_LOG_DEBUG("json {}", tao::json::value{ { "x", 1 } });
      /* CB_LOG_DEBUG("host={}", hostname); */
      // CB_LOG_DEBUG("host={}", hostname);
    }
  CPP

  SELF_TEST_EXPECTATIONS = {
    2 => ["hostname<sd>"],                 # plain unannotated argument
    3 => [],                               # suppressed by a trailing no-redact comment
    4 => [],                               # already annotated
    5 => [],                               # _RAW cannot carry annotations
    6 => ["port<sd>"],                     # per-argument, not per-call: one wrapped, one not
    7 => [],                               # identifiers inside a string literal are not values
    8 => [],                               # ... including the format string itself
    9 => ["bucket_name<md>"],              # raw string literals delimit correctly
    10 => ["bootstrap_hostname<sd>"],      # accessor on a session
    11 => [],                              # a count of endpoints is not an endpoint
    12 => ["id<ud>"],                      # request.id is a document key
    13 => [],                              # ... and document() annotates it, despite no one tag
    14 => [],                              # session.id() is SDK-generated
    15 => [],                              # CB_LOG_PROTOCOL is out of scope
    16 => [],                              # tao::json::value is a type, not a document body
  }.freeze

  def self.self_test
    parsed = statements("<self-test>", SELF_TEST_SOURCE)
    failures = []

    expected_lines = SELF_TEST_EXPECTATIONS.keys.sort
    actual_lines = parsed.map(&:line).sort
    if expected_lines != actual_lines
      failures << "extracted statements on lines #{actual_lines.inspect}, expected #{expected_lines.inspect}"
    end

    parsed.each do |statement|
      expected = SELF_TEST_EXPECTATIONS[statement.line]
      next if expected.nil?

      actual = findings_for(statement, []).map do |finding|
        "#{finding.identifier}<#{WRAPPERS[finding.category]}>"
      end
      next if actual.sort == expected.sort

      failures << "line #{statement.line}: got #{actual.inspect}, expected #{expected.inspect}"
    end

    if failures.empty?
      puts "self-test: #{parsed.size} statements, #{SELF_TEST_EXPECTATIONS.size} expectations, all pass"
      return 0
    end

    failures.each { |failure| warn "self-test FAILED: #{failure}" }
    1
  end

  def self.run(argv)
    options = { mode: :check, roots: [] }
    parser = OptionParser.new do |opts|
      opts.banner = "Usage: bin/check-log-annotations [options] [paths...]"
      opts.on("--catalog", "Print an inventory of every log statement instead of checking") do
        options[:mode] = :catalog
      end
      opts.on("--check", "Report log arguments that look sensitive but are not annotated") do
        options[:mode] = :check
      end
      opts.on("--self-test", "Check the analysis itself against a built-in fixture") do
        options[:mode] = :self_test
      end
      opts.on("-h", "--help", "Show this message") do
        puts opts
        exit 0
      end
    end
    parser.parse!(argv)

    repository = File.expand_path("..", __dir__)
    Dir.chdir(repository)

    return self_test if options[:mode] == :self_test

    roots = argv.empty? ? %w[core couchbase] : argv
    roots = roots.select do |root|
      next true if File.exist?(root)

      warn "skipping #{root}: no such file or directory"
      false
    end
    if roots.empty?
      warn "nothing to scan"
      return 1
    end

    suppressed_files, suppressed_identifiers = load_suppressions(SUPPRESSIONS_FILE)

    all_statements = []
    source_files(roots).each do |path|
      next if suppressed_files.any? { |glob| matches_glob?(glob, path) }

      all_statements << [path, statements(path, File.read(path))]
    end

    if options[:mode] == :catalog
      print_catalog(all_statements.flat_map(&:last))
      return 0
    end

    findings = all_statements.flat_map do |path, in_file|
      here = suppressed_identifiers.filter_map do |glob, identifier|
        identifier if matches_glob?(glob, path)
      end
      in_file.flat_map { |statement| findings_for(statement, here) }
    end

    if findings.empty?
      puts "No unannotated sensitive arguments found in #{all_statements.size} files."
      return 0
    end

    print_findings(findings)
    1
  end
end

exit LogAnnotations.run(ARGV) if $PROGRAM_NAME == __FILE__
